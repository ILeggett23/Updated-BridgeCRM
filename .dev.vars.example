# Copy this file to .dev.vars for local Worker development.
# Never commit .dev.vars or production values.

BACKEND_ONLY=false
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8787
PUBLIC_APP_URL=http://localhost:8787/
AUTH_ENABLED=false
AUTH_REQUIRE_TURNSTILE=false
AUTH_HASH_PEPPER=replace-with-a-long-random-local-development-value
TURNSTILE_SITE_KEY=replace-with-a-development-site-key
TURNSTILE_SECRET_KEY=replace-with-a-development-secret-key
AUTH_EMAIL_FROM=no-reply@example.com
AUTH_EMAIL_NAME=Bridge CRM
ENVIRONMENT=development

# Required only for hosted Web Push testing.
VAPID_PUBLIC_KEY=replace-with-a-development-public-key
VAPID_PRIVATE_KEY=replace-with-a-development-private-key
VAPID_SUBJECT=mailto:developer@example.com
PUSH_DISPATCH_SECRET=replace-with-a-long-random-local-development-value
